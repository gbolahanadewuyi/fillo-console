#!/usr/bin/env bash
# Runs `npm run verify` (lint, tests, production build) before anything is pushed to develop or master.
# Bypass only in an emergency:  SKIP_VERIFY=1 git push
set -Eeuo pipefail

[ "${SKIP_VERIFY:-0}" = "1" ] && { echo "pre-push: SKIP_VERIFY=1, not running checks." >&2; exit 0; }

needs_check=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  case "$remote_ref" in
    refs/heads/develop|refs/heads/master) needs_check=1 ;;
  esac
done
[ "$needs_check" = "1" ] || exit 0

echo "pre-push: pushing to develop/master, running checks first..." >&2
cd "$(git rev-parse --show-toplevel)"
npm run verify
