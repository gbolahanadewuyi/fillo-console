# Copy to .env for local dev.
# VITE_API_URL=http://127.0.0.1:8090/v1

# ── Sign-in system ──────────────────────────────────────────────────────────
# Our own accounts. VITE_API_URL must point at an API running with AUTH_PROVIDER=local, and the console and API
# must be on the same site (e.g. console.fillo.cloud + api.fillo.cloud) so the refresh cookie is sent.
# Not usable on *.sslip.io test hostnames.
# VITE_SHOW_DEMO_ACCOUNTS=true # show the demo-account picker on the login page (always shown in dev builds)
# VITE_DEMO_PASSWORD=       # staging only: password the demo buttons fill in (must match the staging accounts)
